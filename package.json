    "jose": "^6.2.17",
    "next": "16.4.6",
    "node-ical": "^0.27.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
