# Kopieer naar .env en vul in. Zet .env NOOIT in git.

# Domein waarop de app draait (DNS A-record naar je VPS). Caddy regelt HTTPS.
DOMAIN=os.example.nl

# Wachtwoord voor de database (willekeurig, lang). Genereer: openssl rand -hex 24
POSTGRES_PASSWORD=

# Geheim voor login-sessies (minimaal 32 tekens). Genereer: openssl rand -hex 32
SESSION_SECRET=

# Hash van je inlogwachtwoord. Genereer lokaal: npm run hash-password -- "jouw-wachtwoord"
APP_PASSWORD_HASH=

# Token voor de AI-koppeling (minimaal 24 tekens). Genereer: openssl rand -hex 32
MCP_TOKEN=

# Agenda's als ICS-links, komma-gescheiden, optioneel met naam: Naam|url
# Google: Agenda-instellingen > "Geheim adres in iCal-indeling"
# iCloud: agenda delen > Openbare agenda > link kopiëren (webcal:// mag)
CALENDAR_ICS_URLS=

APP_TIMEZONE=Europe/Amsterdam
