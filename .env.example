# Kopieer naar .env en vul in. Zet .env NOOIT in git.

# Domein waarop de app draait (DNS A-record naar je VPS). Caddy regelt HTTPS.
DOMAIN=os.example.nl

# Wachtwoord voor de database (willekeurig, lang). Genereer: openssl rand -hex 24
POSTGRES_PASSWORD=

# Geheim voor login-sessies (minimaal 32 tekens). Genereer: openssl rand -hex 32
SESSION_SECRET=

# Hash van je inlogwachtwoord. Genereer lokaal: npm run hash-password -- "jouw-wachtwoord"
APP_PASSWORD_HASH=

# Token voor de AI-koppeling (minimaal 24 tekens). Genereer: openssl rand -hex 32
MCP_TOKEN=

# Agenda's als ICS-links, komma-gescheiden, optioneel met naam: Naam|url
# Google: Agenda-instellingen > "Geheim adres in iCal-indeling"
# iCloud: agenda delen > Openbare agenda > link kopiëren (webcal:// mag)
CALENDAR_ICS_URLS=

APP_TIMEZONE=Europe/Amsterdam

# Sleutel voor de versleutelde back-ups (ook in je wachtwoordmanager). Genereer: openssl rand -hex 24
BACKUP_PASSPHRASE=

# Semantisch zoeken (second brain): voyage of openai, met sleutel. Leeg = zoeken op trefwoord.
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=

# Hermes (AI-assistent). Sleutels maakt scripts/ensure-env.sh aan; installeren met scripts/hermes-setup.sh
HERMES_MCP_TOKEN=
HERMES_API_KEY=
ANTHROPIC_API_KEY=
HERMES_MODEL=claude-sonnet-5-5
# Intern adres van Hermes; leeg = Hermes niet geïnstalleerd
HERMES_URL=
# COMPOSE_PROFILES=hermes

# Pushmeldingen: leeg laten, dan maakt de app de VAPID-sleutels zelf aan.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:info@marclonsain.nl
