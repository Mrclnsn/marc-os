{$DOMAIN} {
	# Niet comprimeren voor de chat met Hermes: die stroomt per regel binnen
	@comprimeer not path /api/hermes/*
	encode @comprimeer zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	# Akkoord uit WhatsApp komt alleen van Hermes over het interne netwerk, nooit van buiten
	respond /api/whatsapp/* 404

	# Geen access-log: zo komt de geheime MCP-URL nergens in logbestanden

	reverse_proxy app:3000
}
